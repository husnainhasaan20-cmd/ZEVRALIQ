<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZEVRALIQ — Define Your Standard</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #080808;
      color: #ffffff;
      line-height: 1.5;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* NAVBAR */
    nav {
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 6%;
      border-bottom: 1px solid #222;
      position: sticky;
      top: 0;
      background: rgba(8,8,8,0.95);
      backdrop-filter: blur(10px);
      z-index: 10;
    }

    .logo {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 5px;
    }

    .nav-links {
      display: flex;
      gap: 28px;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .cart {
      border: 1px solid #555;
      padding: 8px 14px;
      border-radius: 3px;
      font-size: 12px;
    }

    /* HERO */
    .hero {
      min-height: 82vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 80px 20px;
      background:
        radial-gradient(circle at center, #252525 0%, #101010 35%, #080808 70%);
    }

    .hero-content {
      max-width: 900px;
    }

    .hero-small {
      color: #aaa;
      font-size: 12px;
      letter-spacing: 5px;
      text-transform: uppercase;
      margin-bottom: 25px;
    }

    .hero h1 {
      font-size: clamp(48px, 10vw, 110px);
      letter-spacing: 12px;
      font-weight: 900;
      margin-bottom: 20px;
    }

    .hero p {
      color: #c8c8c8;
      font-size: 15px;
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-bottom: 40px;
    }

    .button {
      display: inline-block;
      padding: 15px 34px;
      background: white;
      color: black;
      font-weight: bold;
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      transition: 0.3s;
    }

    .button:hover {
      background: #bbb;
      transform: translateY(-2px);
    }

    /* SECTION */
    section {
      padding: 80px 6%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-title h2 {
      font-size: 32px;
      letter-spacing: 4px;
      margin-bottom: 10px;
    }

    .section-title p {
      color: #888;
      font-size: 13px;
      letter-spacing: 2px;
    }

    /* PRODUCTS */
    .products {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .product {
      background: #111;
      border: 1px solid #242424;
      overflow: hidden;
      transition: 0.3s;
    }

    .product:hover {
      transform: translateY(-5px);
      border-color: #555;
    }

    .product-image {
      height: 360px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(145deg, #252525, #0d0d0d);
      color: #777;
      font-size: 12px;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .product-info {
      padding: 22px;
    }

    .product-info h3 {
      font-size: 16px;
      letter-spacing: 2px;
      margin-bottom: 8px;
    }

    .product-info p {
      color: #888;
      font-size: 13px;
      margin-bottom: 15px;
    }

    .price {
      font-weight: bold;
      letter-spacing: 1px;
    }

    /* ABOUT */
    .about {
      text-align: center;
      max-width: 750px;
      margin: auto;
    }

    .about h2 {
      font-size: 34px;
      letter-spacing: 5px;
      margin-bottom: 20px;
    }

    .about p {
      color: #999;
      font-size: 15px;
    }

    /* NEWSLETTER */
    .newsletter {
      background: #111;
      text-align: center;
      border-top: 1px solid #222;
      border-bottom: 1px solid #222;
    }

    .newsletter h2 {
      font-size: 28px;
      letter-spacing: 3px;
      margin-bottom: 12px;
    }

    .newsletter p {
      color: #888;
      margin-bottom: 25px;
    }

    .email-box {
      display: flex;
      max-width: 480px;
      margin: auto;
    }

    .email-box input {
      flex: 1;
      padding: 15px;
      background: #080808;
      border: 1px solid #444;
      color: white;
      outline: none;
    }

    .email-box button {
      padding: 15px 22px;
      border: none;
      background: white;
      color: black;
      font-weight: bold;
      cursor: pointer;
    }

    /* FOOTER */
    footer {
      padding: 45px 6%;
      text-align: center;
      border-top: 1px solid #222;
    }

    footer .footer-logo {
      font-size: 20px;
      font-weight: bold;
      letter-spacing: 5px;
      margin-bottom: 12px;
    }

    footer p {
      color: #666;
      font-size: 12px;
    }

    .social {
      margin-top: 20px;
      display: flex;
      justify-content: center;
      gap: 20px;
      color: #aaa;
      font-size: 12px;
      letter-spacing: 1px;
    }

    /* MOBILE */
    @media (max-width: 700px) {
      .nav-links {
        display: none;
      }

      .hero h1 {
        letter-spacing: 5px;
      }

      .products {
        grid-template-columns: 1fr;
      }

      .product-image {
        height: 300px;
      }

      .email-box {
        flex-direction: column;
        gap: 8px;
      }

      .email-box input,
      .email-box button {
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <!-- NAVIGATION -->
  <nav>
    <div class="logo">ZEVRALIQ</div>

    <div class="nav-links">
      <a href="#collection">Collection</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </div>

    <div class="cart">CART (0)</div>
  </nav>

  <!-- HERO -->
  <header class="hero">
    <div class="hero-content">

      <div class="hero-small">
        Premium Contemporary Wear
      </div>

      <h1>ZEVRALIQ</h1>

      <p>DEFINE YOUR STANDARD.</p>

      <a href="#collection" class="button">
        Explore Collection
      </a>

    </div>
  </header>

  <!-- COLLECTION -->
  <section id="collection">

    <div class="section-title">
      <h2>THE COLLECTION</h2>
      <p>ESSENTIALS / 01</p>
    </div>

    <div class="products">

      <div class="product">
        <div class="product-image">
          ZEVRALIQ
        </div>

        <div class="product-info">
          <h3>CORE TEE</h3>
          <p>Heavyweight premium cotton</p>
          <div class="price">PKR 3,499</div>
        </div>
      </div>

      <div class="product">
        <div class="product-image">
          ZEVRALIQ
        </div>

        <div class="product-info">
          <h3>ESSENTIAL HOODIE</h3>
          <p>Premium heavyweight fleece</p>
          <div class="price">PKR 6,999</div>
        </div>
      </div>

      <div class="product">
        <div class="product-image">
          ZEVRALIQ
        </div>

        <div class="product-info">
          <h3>CORE TROUSER</h3>
          <p>Relaxed premium fit</p>
          <div class="price">PKR 5,499</div>
        </div>
      </div>

    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">

    <div class="about">

      <h2>DEFINE YOUR STANDARD.</h2>

      <p>
        ZEVRALIQ is built for those who refuse ordinary.
        Clean silhouettes, premium materials and distinctive
        design come together to create contemporary clothing
        made for everyday confidence.
      </p>

    </div>

  </section>

  <!-- NEWSLETTER -->
  <section class="newsletter" id="contact">

    <h2>JOIN ZEVRALIQ</h2>

    <p>Be the first to know about new drops and limited releases.</p>

    <div class="email-box">
      <input type="email" placeholder="Enter your email">
      <button onclick="subscribe()">JOIN</button>
    </div>

  </section>

  <!-- FOOTER -->
  <footer>

    <div class="footer-logo">ZEVRALIQ</div>

    <p>DEFINE YOUR STANDARD.</p>

    <div class="social">
      <a href="#">INSTAGRAM</a>
      <a href="#">TIKTOK</a>
      <a href="#">FACEBOOK</a>
    </div>

    <br>

    <p>© 2026 ZEVRALIQ. All rights reserved.</p>

  </footer>

  <script>
    function subscribe() {
      alert("Thank you for joining ZEVRALIQ.");
    }
  </script>

</body>
</html>
